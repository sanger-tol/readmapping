/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests for ULI PacBio data
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run sanger-tol/readmapping -profile test_uli,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile for ULI data'
    config_profile_description = 'Minimal test dataset to check pipeline function on PacBio ULI data'

    // Input data
    input = "${projectDir}/assets/samplesheet_uli.csv"

    // Output directory
    outdir = "results_uli"

    // Alignment
    alignment_format = "bam"
    compression = "none"

    // Fasta references
    fasta = "https://tolit.cog.sanger.ac.uk/test-data/Acropora_cervicornis/assembly/release/reference/insdc/GCA_964034985.1.subset.fasta.gz"
}
