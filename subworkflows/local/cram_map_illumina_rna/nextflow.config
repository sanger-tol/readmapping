nextflow.enable.moduleBinaries = true

process {
    withName: CRAMALIGN_STARALIGNHIC { //REWRITE THIS FOR STAR PARAMS
        ext.args1 = { ""                  }
        ext.args2 = { "-F0xB00 -nt"       }
        ext.args3 = { "-5SPCp"            }
        ext.args4 = { "-mpu"              }
        ext.args5 = { "-q 0 -F 0x904"     }
        ext.args6 = { "--write-index -l1" }

    }
}
