include { STAR_GENOMEGENERATE        } from '../../../modules/local/star/genomegenerate/main'
include { STAR_ALIGN                 } from '../../../modules/local/star/align/main'
include { SAMTOOLS_INDEX             } from '../../../modules/nf-core/samtools/index/main'

include { BAM_SAMTOOLS_MERGE_MARKDUP } from '../bam_samtools_merge_markdup/main'

workflow CRAM_MAP_ILLUMINA_RNASEQ {

    take:
    ch_assemblies        // Channel [meta, assembly]
    ch_rnaseq_cram       // Channel [meta, cram] OR [meta, [cram1, cram2, ..., cram_n]]
    val_aligner          // string: [ "star" ]

    main:
    //
    // Logic: rolling check of assembly meta objects to detect duplicates
    //
    def val_asm_meta_list = Collections.synchronizedSet(new HashSet())

    ch_assemblies
        .map { meta, _sample ->
            if (!val_asm_meta_list.add(meta)) {
                error("Error: Duplicate meta object found in `ch_assemblies` in CRAM_MAP_ILLUMINA_RNASEQ: ${meta}")
            }
            meta
        }

    //
    // Logic: check if CRAM files are accompanied by an index
    //        Get indexes, and index those that aren't
    //
    ch_rnaseq_cram_meta_mod = ch_rnaseq_cram
        .transpose()
        .map { meta, cram -> [ meta + [ cramfile: cram ], cram ]}

    ch_rnaseq_cram_raw = ch_rnaseq_cram_meta_mod
            .branch { meta, cram ->
                def index = file(cram.toUriString() + ".crai")
                have_index: index.exists()
                    return [ meta, cram, index ]
                no_index: true
                    return [ meta, cram ]
            }

    //
    // Module: Index CRAM files without indexes
    //
    SAMTOOLS_INDEX(ch_rnaseq_cram_raw.no_index)

    ch_rnaseq_cram_indexed = ch_rnaseq_cram_raw.have_index
        .mix(
            ch_rnaseq_cram_raw.no_index.join(SAMTOOLS_INDEX.out.index)
        )

    //
    // Logic: Begin alignment - fork depending on specified aligner
    //
    if(val_aligner == "star") {
        //
        // Module: Create star index for assembly
        //
        
        STAR_GENOMEGENERATE(ch_assemblies)
        ch_star_index=STAR_GENOMEGENERATE.out.index

        STAR_ALIGN(
            ch_rnaseq_cram_indexed,
            ch_star_index
        )
	println "Alignment finished"        
        ch_mapped_bam = STAR_ALIGN.out.bam
	ch_mapped_bam.view{ x -> "DEBUG: input = ${x}"}
    } else {
        error("Unsupported aligner: ${val_aligner}")
    }


    //
    // Subworkflow: merge BAM files and mark duplicates
    //
    println "About to merge"
    BAM_SAMTOOLS_MERGE_MARKDUP(
        ch_mapped_bam,
        ch_assemblies,
        true
    )
    bam=BAM_SAMTOOLS_MERGE_MARKDUP.out.bam
    bam.view{ x -> "DEBUG: input = ${x}"}

    emit:
    bam               = BAM_SAMTOOLS_MERGE_MARKDUP.out.bam
    bam_index         = BAM_SAMTOOLS_MERGE_MARKDUP.out.bam_index
    bam_markdup_stats = BAM_SAMTOOLS_MERGE_MARKDUP.out.metrics
}
