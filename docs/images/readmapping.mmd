%% --- METRO DATA LINES ---
%%metro line: reference | Reference Genome | #FA6863
%%metro line: pacbio_std | PacBio HiFi Standard | #3498db
%%metro line: pacbio_uli | PacBio HiFi ULI | #00bcd4
%%metro line: pacbio_pimms | PacBio HiFi PiMmS | #00e676
%%metro line: pacbio_amplified | PacBio HiFi Amplified | #e67e22
%%metro line: ont_clr | ONT / PacBio CLR | #f1c40f
%%metro line: short_reads | Illumina / Hi-C | #e63946
%%metro line: qc | Pre/Post-align QC & MultiQC | #9b59b6

%% --- INPUT & OUTPUT FILES ---
%%metro file: in_ref | FASTA
%%metro file: in_pacbio_std | FASTQ
%%metro file: in_pacbio_std | BAM
%%metro file: in_pacbio_uli | FASTQ
%%metro file: in_pacbio_uli | BAM
%%metro file: in_pacbio_pimms | FASTQ
%%metro file: in_pacbio_pimms | BAM
%%metro file: in_pacbio_amplified | FASTQ
%%metro file: in_pacbio_amplified | BAM
%%metro file: in_ont_clr | FASTQ
%%metro file: in_ont_clr | BAM
%%metro file: in_short | FASTQ
%%metro file: in_short | CRAM
%%metro file: cram_out | CRAM
%%metro file: crai_out | CRAI
%%metro file: stats_out | stats
%%metro file: bedgraph_out | bedgraph
%%metro file: multiqc_out | HTML

%% --- OFF-TRACK ANCHORS ---
%%metro off_track: in_ref
%%metro off_track: in_pacbio_std
%%metro off_track: in_pacbio_uli
%%metro off_track: in_pacbio_pimms
%%metro off_track: in_pacbio_amplified
%%metro off_track: in_ont_clr
%%metro off_track: in_short
%%metro off_track: cram_out
%%metro off_track: crai_out
%%metro off_track: stats_out
%%metro off_track: bedgraph_out
%%metro off_track: multiqc_out

%% --- GRID DEFINITIONS ---
%%metro grid: inputs_block | 0, 0, 2
%%metro grid: pre_qc_block | 1, 0, 3
%%metro grid: pacbio_prep_block | 2, 0, 4
%%metro grid: chunk_align_block | 3, 0, 5
%%metro grid: postprocess_block | 4, 0, 4
%%metro grid: multiqc_block | 5, 0, 2

graph LR
    %% ==========================================
    %% 1. BLOCK: INPUT FILES
    %% ==========================================
    subgraph inputs_block [1 Input Files]
        %%metro exit: right | reference,pacbio_std,pacbio_uli,pacbio_pimms,pacbio_amplified,ont_clr,short_reads
        in_ref[ ]
        in_pacbio_std[ ]
        in_pacbio_uli[ ]
        in_pacbio_pimms[ ]
        in_pacbio_amplified[ ]
        in_ont_clr[ ]
        in_short[ ]
    end

    %% ==========================================
    %% 2. BLOCK: REFERENCE INDEXING & PRE-ALIGN QC
    %% ==========================================
    subgraph pre_qc_block [2 Indexing & Pre-Align QC]
        %%metro entry: left | reference,pacbio_std,pacbio_uli,pacbio_pimms,pacbio_amplified,ont_clr,short_reads
        %%metro exit: right | reference,pacbio_std,pacbio_uli,pacbio_pimms,pacbio_amplified,ont_clr,short_reads

        ref_index[Reference Indexing\nFaidx / BWA / MM2]
        fastqc_pre[FastQC\nPre-align QC]

        in_ref -->|reference| ref_index
        in_pacbio_std -->|pacbio_std| fastqc_pre
        in_pacbio_uli -->|pacbio_uli| fastqc_pre
        in_pacbio_pimms -->|pacbio_pimms| fastqc_pre
        in_pacbio_amplified -->|pacbio_amplified| fastqc_pre
        in_ont_clr -->|ont_clr| fastqc_pre
        in_short -->|short_reads| fastqc_pre
    end

    %% ==========================================
    %% 3. BLOCK: PACBIO PREPROCESSING
    %% ==========================================
    subgraph pacbio_prep_block [3 PacBio Preprocessing]
        %%metro entry: left | pacbio_std,pacbio_uli,pacbio_pimms,pacbio_amplified
        %%metro exit: right | pacbio_std,pacbio_uli,pacbio_pimms,pacbio_amplified

        lima[Lima\nDemux]
        pbmarkdup[PBMarkdup\nDeduplication]
        hifitrimmer[HifiTrimmer\nAdapter Trim]

        fastqc_pre -->|pacbio_uli,pacbio_pimms| lima
        fastqc_pre -->|pacbio_std,pacbio_amplified| pbmarkdup

        lima -->|pacbio_uli,pacbio_pimms| pbmarkdup
        pbmarkdup -->|pacbio_std,pacbio_uli,pacbio_pimms,pacbio_amplified| hifitrimmer
    end

    %% ==========================================
    %% 4. BLOCK: CHUNKING & ALIGNMENT
    %% ==========================================
    subgraph chunk_align_block [4 Chunking & Alignment]
        %%metro entry: left | reference,pacbio_std,pacbio_uli,pacbio_pimms,pacbio_amplified,ont_clr,short_reads
        %%metro exit: right | reference,pacbio_std,pacbio_uli,pacbio_pimms,pacbio_amplified,ont_clr,short_reads

        chunk_reads[CramAlign\nGenCramChunks]
        align_long[Minimap2\nAlign Long]
        align_short[BWAMEM2 / Minimap2\nAlign Short]
        merge_aligned[Samtools\nMergeMarkdup]

        fastqc_pre -->|ont_clr,short_reads| chunk_reads
        hifitrimmer -->|pacbio_std,pacbio_uli,pacbio_pimms,pacbio_amplified| chunk_reads

        chunk_reads -->|pacbio_std,pacbio_uli,pacbio_pimms,pacbio_amplified,ont_clr| align_long
        chunk_reads -->|short_reads| align_short

        ref_index -->|reference| align_long
        ref_index -->|reference| align_short

        align_long -->|pacbio_std,pacbio_uli,pacbio_pimms,pacbio_amplified,ont_clr| merge_aligned
        align_short -->|short_reads| merge_aligned
    end

    %% ==========================================
    %% 5. BLOCK: POST-PROCESSING & METRICS
    %% ==========================================
    subgraph postprocess_block [5 Post-Processing & Stats]
        %%metro entry: left | reference,pacbio_std,pacbio_uli,pacbio_pimms,pacbio_amplified,ont_clr,short_reads
        %%metro exit: right | qc

        crumble[Crumble\nCompression]
        cram_conv[Samtools CRAM\n& Index]
        sam_stats[Samtools\nStats, Flagstat, Idxstats]
        blobtk[BlobTK Depth\nCoverage]

        cram_out[ ]
        crai_out[ ]
        stats_out[ ]
        bedgraph_out[ ]

        merge_aligned -->|pacbio_std,pacbio_uli,pacbio_pimms,pacbio_amplified,ont_clr,short_reads| crumble
        crumble -->|pacbio_std,pacbio_uli,pacbio_pimms,pacbio_amplified,ont_clr,short_reads| cram_conv
        ref_index -->|reference| cram_conv

        cram_conv -->|pacbio_std,pacbio_uli,pacbio_pimms,pacbio_amplified,ont_clr,short_reads| cram_out
        cram_conv -->|pacbio_std,pacbio_uli,pacbio_pimms,pacbio_amplified,ont_clr,short_reads| crai_out

        cram_conv -->|qc| sam_stats
        cram_conv -->|qc| blobtk

        sam_stats -->|qc| stats_out
        blobtk -->|qc| bedgraph_out
    end

    %% ==========================================
    %% 6. BLOCK: MULTIQC REPORTING
    %% ==========================================
    subgraph multiqc_block [6 QC Reporting]
        %%metro entry: left | qc
        %%metro exit: right | qc

        multiqc[MultiQC\nReport]
        multiqc_out[ ]

        fastqc_pre -->|qc| multiqc
        sam_stats -->|qc| multiqc
        blobtk -->|qc| multiqc

        multiqc -->|qc| multiqc_out
    end
